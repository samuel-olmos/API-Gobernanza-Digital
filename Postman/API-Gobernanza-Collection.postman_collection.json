            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Recoleccion Residuos\",\n  \"descripcion\": \"Servicio municipal\",\n  \"montoBase\": 150.00,\n  \"frecuenciaId\": 1\n}"
