              "raw": "{\n  \"id\": {{servicioId}},\n  \"nombre\": \"Recoleccion Residuos\",\n  \"descripcion\": \"Servicio municipal actualizado\",\n  \"montoBase\": 160.00,\n  \"frecuenciaId\": 1\n}"
